# Database container environment variables (PostgreSQL)
# These values match the startup.sh defaults and are used by tooling (e.g., db_visualizer).
#
# NOTE: startup.sh currently sets DB_NAME/DB_USER/DB_PASSWORD/DB_PORT internally.
# If you change them in startup.sh, keep this file in sync.

POSTGRES_URL=postgresql://localhost:5001/myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5001
